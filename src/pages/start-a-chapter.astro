---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Start a Chapter | Impact Collective">
  <Header />
  <section id="main-content" class="w-full" style="background-color: var(--color-bg-lavender);">
    <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12">
      <h1 class="text-center mb-6" style="font-family: var(--font-primary); font-size: 48px; font-weight: 400; letter-spacing: -1.9px; color: #000000;">
        How to Start and Run a Chapter
      </h1>
      <p class="text-center mb-12 mx-auto" style="font-family: var(--font-primary); font-size: 18px; color: var(--color-text-body); max-width: 700px;">
        Impact Collective makes it easy for any high school student to launch a Kiva-affiliated microfinance chapter. Follow these four steps to get started.
      </p>

      <h2 class="text-center mb-8" style="font-family: var(--font-primary); font-size: 24px; font-weight: 400; color: #000000;">
        Our Goal
      </h2>
      <p class="text-center mb-12 mx-auto" style="font-family: var(--font-primary); font-size: 16px; color: var(--color-text-body); max-width: 700px;">
        Empower students to build sustainable businesses that fund microloans to underserved communities worldwide, promoting global financial inclusion through action.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center p-6" style="background: #ffffff; border: 1px solid #e0e0e0;">
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 12px;">1. Apply</h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 16px;">
            Fill out our chapter application form and tell us about your school, your team, and your goals.
          </p>
          <a href="#" class="inline-block px-6 py-2 no-underline" style="background: var(--color-btn-primary-bg); color: #ffffff; font-family: var(--font-primary); font-size: 14px; border-radius: 100px;">
            Apply Now
          </a>
        </div>
        <div class="text-center p-6" style="background: #ffffff; border: 1px solid #e0e0e0;">
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 12px;">2. Launch a Business</h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 16px;">
            Start a student-run venture to generate sustainable capital for your chapter's microloans.
          </p>
          <a href="/launch-your-business" class="inline-block px-6 py-2 no-underline" style="background: var(--color-btn-primary-bg); color: #ffffff; font-family: var(--font-primary); font-size: 14px; border-radius: 100px;">
            Learn How
          </a>
        </div>
        <div class="text-center p-6" style="background: #ffffff; border: 1px solid #e0e0e0;">
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 12px;">3. Lend on Kiva</h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 16px;">
            Use your earned profits to fund microloans through Kiva to low-income borrowers around the world.
          </p>
          <a href="https://www.kiva.org/" target="_blank" rel="noopener" class="inline-block px-6 py-2 no-underline" style="background: var(--color-btn-primary-bg); color: #ffffff; font-family: var(--font-primary); font-size: 14px; border-radius: 100px;">
            Visit Kiva
          </a>
        </div>
        <div class="text-center p-6" style="background: #ffffff; border: 1px solid #e0e0e0;">
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 12px;">4. Outreach & Scale</h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 16px;">
            Grow your chapter, recruit new members, and expand your impact through community outreach.
          </p>
          <a href="#" class="inline-block px-6 py-2 no-underline" style="background: var(--color-btn-primary-bg); color: #ffffff; font-family: var(--font-primary); font-size: 14px; border-radius: 100px;">
            Get Tips
          </a>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Base>
