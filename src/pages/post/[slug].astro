---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import posts from '../../data/posts.json';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const date = new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base title={`${post.title} | Impact Collective`}>
  <Header />
  <section id="main-content" class="w-full" style="background-color: var(--color-bg-white);">
    <article class="mx-auto px-4 py-12" style="max-width: 740px;">
      <a href="/blog" style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-link);">&larr; All Posts</a>
      <p style="font-family: var(--font-primary); font-size: 14px; color: #000000; margin: 24px 0 16px;">
        {post.author} &middot; {date} &middot; {post.readTime} min read
      </p>
      <h1 style="font-family: var(--font-primary); font-size: 40px; font-weight: 400; line-height: 52px; letter-spacing: -0.4px; color: #000000; margin-bottom: 32px;">
        {post.title}
      </h1>
      <div class="post-body" set:html={post.html} />
    </article>
  </section>
  <Footer />
</Base>

<style is:global>
  .post-body {
    font-family: var(--font-primary);
    font-size: 18px;
    line-height: 27px;
    color: #000000;
  }
  .post-body p,
  .post-body ul,
  .post-body ol,
  .post-body blockquote,
  .post-body figure {
    margin-bottom: 20px;
  }
  .post-body h2 {
    font-size: 28px;
    line-height: 38px;
    font-weight: 400;
    margin: 36px 0 16px;
  }
  .post-body h3 {
    font-size: 22px;
    line-height: 30px;
    font-weight: 400;
    margin: 28px 0 12px;
  }
  .post-body ul {
    list-style: disc;
    padding-left: 28px;
  }
  .post-body ol {
    list-style: decimal;
    padding-left: 28px;
  }
  .post-body li p {
    margin-bottom: 8px;
  }
  .post-body a {
    color: var(--color-text-link);
  }
  .post-body blockquote {
    border-left: 3px solid var(--color-text-link);
    padding-left: 20px;
    font-size: 20px;
  }
  .post-body img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    height: auto;
  }
  .post-body hr {
    margin: 32px 0;
    border-color: #e5e5e5;
  }
</style>
