---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Executive Board | Impact Collective">
  <Header />
  <section id="main-content" class="w-full" style="background-color: var(--color-bg-lavender);">
    <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12">
      <h1 class="text-center mb-12" style="font-family: var(--font-primary); font-size: 48px; font-weight: 400; letter-spacing: -1.9px; color: #000000;">
        Executive Board
      </h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 justify-items-center" style="max-width: 800px; margin: 0 auto;">
        <div class="text-center">
          <img src="/images/team-rishi.jpg" alt="Rishi Mishra" width="279" height="285" class="object-cover" style="width: 279px; height: 285px; margin: 0 auto 16px;" />
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 4px;">
            Rishi Mishra
          </h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 12px;">
            President / Director of Operations
          </p>
          <a href="/docs/rishi-mishra-bio.pdf" style="font-family: var(--font-light); font-size: 15px; color: var(--color-text-link); text-decoration: underline;">
            Read More
          </a>
        </div>
        <div class="text-center">
          <img src="/images/team-blane.png" alt="Blane McElroy" width="279" height="285" class="object-cover" style="width: 279px; height: 285px; margin: 0 auto 16px;" />
          <h3 style="font-family: var(--font-primary); font-size: 20px; font-weight: 400; color: #000000; margin-bottom: 4px;">
            Blane McElroy
          </h3>
          <p style="font-family: var(--font-primary); font-size: 14px; color: var(--color-text-body); margin-bottom: 12px;">
            Director of Marketing & Communications
          </p>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Base>
