---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const ventures = [
  { name: "Frostbite's Frozen Ice", image: "/images/venture-frostbite.jpg" },
  { name: "All Day Soiree", image: "/images/venture-allday.jpg" },
  { name: "Baked", image: "/images/venture-baked.jpg" },
  { name: "Curry Kart", image: "/images/venture-currykart.jpg" },
  { name: "Tutor Lion", image: "/images/venture-tutorlion.jpg" },
  { name: "TOSCANA", image: "/images/venture-toscana.jpg" },
  { name: "Beads for Needs", image: "/images/venture-beadsforneeds.jpg" },
];
---

<Base title="Student Ventures | Impact Collective">
  <Header />
  <section id="main-content" class="w-full" style="background-color: var(--color-bg-lavender);">
    <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12">
      <h1 class="text-center mb-12" style="font-family: var(--font-primary); font-size: 48px; font-weight: 400; letter-spacing: -1.9px; color: #000000;">
        Student Ventures
      </h1>

      <div class="flex justify-center mb-12">
        <img
          src="/images/venture-banner.jpg"
          alt="Give a hand up, not a hand out"
          class="w-full max-w-[980px] object-cover"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center">
        {ventures.map((v) => (
          <div class="flex flex-col items-center" style="width: 370px; max-width: 100%;">
            <img
              src={v.image}
              alt={v.name}
              width="370"
              height="267"
              class="object-cover w-full"
              style="height: 267px; background: #e0e0e0;"
            />
            <h3 style="font-family: var(--font-primary); font-size: 18px; font-weight: 400; color: #000000; margin-top: 12px; text-align: center;">
              {v.name}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Base>
