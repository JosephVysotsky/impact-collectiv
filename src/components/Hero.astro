---
---

<section class="w-full" style="background-color: var(--color-bg-lavender);">
  <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12 flex flex-col items-center text-center">
    <!-- H1 -->
    <h1 class="animate-on-scroll" style="font-family: var(--font-primary); font-size: 80px; font-weight: 400; line-height: 80px; letter-spacing: -3.2px; color: #000000;">
      Impact Collective
    </h1>

    <!-- Tagline -->
    <p class="mt-4" style="font-size: 25px; font-weight: 400; letter-spacing: -0.25px;">
      <span style="color: var(--color-accent-build);">Build</span><span style="color: var(--color-text-body);">.</span>
      <span style="color: var(--color-accent-earn);">Earn</span><span style="color: var(--color-text-body);">.</span>
      <span style="color: var(--color-accent-lend);">Lend</span><span style="color: var(--color-text-body);">.</span>
    </p>

    <!-- Subtitle -->
    <p class="mt-3" style="font-family: var(--font-primary); font-size: 25px; font-weight: 400; font-style: italic; color: var(--color-text-body); max-width: 704px;">
      Empowering students to lead Global Financial Inclusion with Microfinance.
    </p>

    <!-- CTA Button -->
    <a href="#" class="mt-6 inline-flex items-center justify-center no-underline" style="width: 188px; height: 55px; background: #ffffff; border: 1px solid #000000; border-radius: 100px; font-family: var(--font-primary); font-size: 16px; font-weight: 400; color: #000000;">
      Get Started
    </a>

  </div>

  <!-- Hero image in wider container -->
  <div class="max-w-[var(--site-max-width)] mx-auto px-4 pb-12">
    <img
      src="/images/hero-teens.jpg"
      alt="Impact Collective students"
      class="w-full animate-on-scroll h-[450px] object-cover object-top"
    />
  </div>
</section>
