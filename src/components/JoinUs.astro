---
---

<section id="join-us" class="w-full" style="background-color: var(--color-bg-lavender);">
  <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12">
    <h2 class="text-center mb-10 animate-on-scroll" style="font-family: var(--font-primary); font-size: 24px; font-weight: 400; line-height: 33.6px; letter-spacing: -0.24px; color: #000000;">
      Join Us
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Contact info -->
      <div style="font-family: var(--font-primary); font-size: 16px; font-weight: 400; color: #000000;">
        <a href="mailto:rishimishra0625@gmail.com" class="block mb-2" style="color: #000000; text-decoration: none;">
          Charlotte, North Carolina
        </a>
        <p class="mb-2">980-371-4030</p>
        <a href="mailto:rishimishra0625@gmail.com" style="color: #000000; text-decoration: none;">
          rishimishra0625@gmail.com
        </a>
      </div>

      <!-- Contact form -->
      <form action="#" method="POST" class="flex flex-col gap-4">
        <div>
          <label class="block mb-1" style="font-family: var(--font-primary); font-size: 14px; color: #000;">First Name</label>
          <input
            type="text"
            name="first_name"
            style="background: #ffffff; border: 1px solid #000000; border-radius: 0; padding: 3px 3px 3px 10px; font-family: var(--font-light); font-size: 14px; color: #000000; width: 100%;"
          />
        </div>
        <div>
          <label class="block mb-1" style="font-family: var(--font-primary); font-size: 14px; color: #000;">Last Name</label>
          <input
            type="text"
            name="last_name"
            style="background: #ffffff; border: 1px solid #000000; border-radius: 0; padding: 3px 3px 3px 10px; font-family: var(--font-light); font-size: 14px; color: #000000; width: 100%;"
          />
        </div>
        <div>
          <label class="block mb-1" style="font-family: var(--font-primary); font-size: 14px; color: #000;">Email *</label>
          <input
            type="email"
            name="email"
            required
            style="background: #ffffff; border: 1px solid #000000; border-radius: 0; padding: 3px 3px 3px 10px; font-family: var(--font-light); font-size: 14px; color: #000000; width: 100%;"
          />
        </div>
        <div>
          <label class="block mb-1" style="font-family: var(--font-primary); font-size: 14px; color: #000;">Message</label>
          <textarea
            name="message"
            style="background: #ffffff; border: 1px solid #000000; border-radius: 0; padding: 10.5px 10px 3px; font-family: var(--font-light); font-size: 14px; color: #000000; width: 100%; min-height: 120px; resize: vertical;"
          ></textarea>
        </div>
        <button
          type="submit"
          style="background: var(--color-btn-primary-bg); color: #000000; border: 1px solid #545454; border-radius: 0; width: 250px; height: 36px; font-family: var(--font-primary); font-size: 14px; cursor: pointer;"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</section>
