---
---

<section class="w-full" style="background-color: var(--color-bg-lavender);">
  <div class="max-w-[var(--content-max-width)] mx-auto px-4 py-12">
    <h2 class="text-center mb-10 animate-on-scroll" style="font-family: var(--font-primary); font-size: 24px; font-weight: 400; line-height: 33.6px; letter-spacing: -0.24px; color: #000000;">
      Our Impact
    </h2>

    <!-- Stats row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center mb-12">
      <div>
        <span style="font-family: var(--font-primary); font-size: 30px; font-weight: 400; color: var(--color-text-white);">
          Members
        </span>
        <h3
          class="stat-number"
          data-target="100"
          data-suffix="+"
          style="font-family: var(--font-primary); font-size: 60px; font-weight: 400; letter-spacing: -2.4px; color: #000000;"
        >
          0
        </h3>
      </div>
      <div>
        <span style="font-family: var(--font-primary); font-size: 30px; font-weight: 400; color: var(--color-text-white);">
          Amount loaned
        </span>
        <h3
          class="stat-number"
          data-target="10000"
          data-prefix="$"
          data-suffix="+"
          style="font-family: var(--font-primary); font-size: 60px; font-weight: 400; letter-spacing: -2.4px; color: #000000;"
        >
          0
        </h3>
      </div>
      <div>
        <span style="font-family: var(--font-primary); font-size: 30px; font-weight: 400; color: var(--color-text-white);">
          No. of Countries
        </span>
        <h3
          class="stat-number"
          data-target="30"
          data-suffix="+"
          style="font-family: var(--font-primary); font-size: 60px; font-weight: 400; letter-spacing: -2.4px; color: #000000;"
        >
          0
        </h3>
      </div>
    </div>
  </div>

  <!-- Full-bleed dollar bills strip -->
  <img
    src="/images/impact-dollar-bills.jpg"
    alt=""
    class="w-full animate-on-scroll"
    style="height: 169px; object-fit: cover; object-position: center;"
  />
</section>
