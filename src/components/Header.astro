---
---

<header class="sticky top-0 z-[51] bg-white w-full" style="height: var(--header-height);">
  <div class="max-w-[var(--content-max-width)] mx-auto h-full flex items-center justify-between px-4 relative">
    <!-- Logo -->
    <a href="/">
      <img src="/images/logo.jpg" alt="Impact Collective" width="270" height="100" class="object-contain" />
    </a>

    <!-- Social icons (top-right) -->
    <div class="absolute top-3 right-4 flex gap-2">
      <a href="https://www.instagram.com/pdmicrofinance/" target="_blank" rel="noopener">
        <img src="/images/icon-instagram.svg" alt="Instagram" width="30" height="30" />
      </a>
      <a href="https://il.linkedin.com/company/wix-com" target="_blank" rel="noopener">
        <img src="/images/icon-linkedin.svg" alt="LinkedIn" width="30" height="30" />
      </a>
      <a href="https://r4u2010.blogspot.com/" target="_blank" rel="noopener">
        <img src="/images/icon-blogger.svg" alt="Blogger" width="30" height="30" />
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button id="mobile-menu-btn" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
      <span class="block w-6 h-0.5 bg-black transition-transform" id="hamburger-1"></span>
      <span class="block w-6 h-0.5 bg-black transition-opacity" id="hamburger-2"></span>
      <span class="block w-6 h-0.5 bg-black transition-transform" id="hamburger-3"></span>
    </button>

    <!-- Navigation -->
    <nav id="main-nav" class="hidden lg:flex items-center gap-6">
      <a href="/#about" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">About Us</a>
      <a href="/#services" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Services</a>
      <a href="/start-a-chapter" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Start a Chapter</a>
      <a href="/student-ventures" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Student Ventures</a>
      <a href="/launch-your-business" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Launch your Business</a>
      <a href="/resources" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Resources</a>
      <a href="/lend-ledger" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Lend Ledger</a>
      <a href="/executive-board" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Executive Board</a>
      <a href="/contact" class="text-sm font-normal text-black no-underline hover:opacity-70" style="font-family: var(--font-primary); font-size: 14px;">Contact us</a>
    </nav>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="hidden lg:hidden bg-white w-full shadow-md absolute top-full left-0 z-50">
    <div class="flex flex-col p-4 gap-3">
      <a href="/#about" class="text-sm text-black py-1">About Us</a>
      <a href="/#services" class="text-sm text-black py-1">Services</a>
      <a href="/start-a-chapter" class="text-sm text-black py-1">Start a Chapter</a>
      <a href="/student-ventures" class="text-sm text-black py-1">Student Ventures</a>
      <a href="/launch-your-business" class="text-sm text-black py-1">Launch your Business</a>
      <a href="/resources" class="text-sm text-black py-1">Resources</a>
      <a href="/lend-ledger" class="text-sm text-black py-1">Lend Ledger</a>
      <a href="/executive-board" class="text-sm text-black py-1">Executive Board</a>
      <a href="/contact" class="text-sm text-black py-1">Contact us</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
